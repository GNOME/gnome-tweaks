#: data/org.gnome.tweaks.metainfo.xml.in:16
msgid "GNOME Tweaks allows adjusting advanced GNOME options."
msgstr "Med GNOME Tweaks kan du justere avanserte GNOME-innstillingar."

#: data/org.gnome.tweaks.metainfo.xml.in:19
msgid ""
"It can manage keyboard mapping customizations, add startup applications, and "
"set custom window controls among other settings."
msgstr ""
"Han kan mellom anna handsame tilpassingar av tastaturoppsettet, leggje til "
"oppstartsappar og setje tilpassa vindaugsknappar."

